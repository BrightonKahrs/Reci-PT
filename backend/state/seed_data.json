    "recipe:3": {
      "title": "Thai Peanut Noodles",
      "description": "Creamy peanut noodles with crispy tofu and fresh vegetables in a savory Thai-inspired sauce.",
      "complexity": "Medium",
      "dietary_preferences": "vegetarian, vegan, dairy-free",
      "ingredients": [
        {"name": "rice noodles", "quantity": "8 oz"},
        {"name": "firm tofu", "quantity": "14 oz block"},
        {"name": "peanut butter", "quantity": "3 tbsp"},
        {"name": "soy sauce", "quantity": "2 tbsp"},
        {"name": "rice vinegar", "quantity": "1 tbsp"},
        {"name": "sesame oil", "quantity": "1 tbsp"},
        {"name": "sriracha", "quantity": "1 tsp"},
        {"name": "garlic", "quantity": "2 cloves, minced"},
        {"name": "red bell pepper", "quantity": "1, sliced"},
        {"name": "shredded carrots", "quantity": "1 cup"},
        {"name": "green onions", "quantity": "3, sliced"},
        {"name": "crushed peanuts", "quantity": "2 tbsp"},
        {"name": "vegetable oil", "quantity": "2 tbsp"}
      ],
      "instructions": [
        {"step_number": 1, "description": "Press tofu to remove excess moisture, then cut into cubes."},
        {"step_number": 2, "description": "Cook rice noodles according to package directions, drain and set aside."},
        {"step_number": 3, "description": "Heat vegetable oil in a large pan and fry tofu until golden on all sides. Remove and set aside."},
        {"step_number": 4, "description": "Whisk together peanut butter, soy sauce, rice vinegar, sesame oil, sriracha, and garlic with 2 tbsp warm water."},
        {"step_number": 5, "description": "Toss noodles with peanut sauce, add bell pepper and carrots."},
        {"step_number": 6, "description": "Top with crispy tofu, green onions, and crushed peanuts."}
      ],
