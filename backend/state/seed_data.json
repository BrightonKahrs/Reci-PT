      "title": "Thai Peanut Noodles",
      "description": "Creamy peanut noodles with crispy tofu and fresh vegetables in a savory Thai-inspired sauce.",
      "comments": "Add extra sriracha for more heat.",
      "complexity": "Medium",
      "dietary_preferences": ["vegetarian", "vegan", "dairy-free"],
      "ingredients": [
        {"name": "rice noodles", "quantity": 225, "unit": "grams", "description": ""},
        {"name": "firm tofu", "quantity": 400, "unit": "grams", "description": "pressed, cubed"},
        {"name": "peanut butter", "quantity": 45, "unit": "grams", "description": "natural, unsweetened"},
        {"name": "soy sauce", "quantity": 30, "unit": "ml", "description": "low sodium"},
        {"name": "rice vinegar", "quantity": 15, "unit": "ml", "description": ""},
        {"name": "sesame oil", "quantity": 15, "unit": "ml", "description": "toasted"},
        {"name": "sriracha", "quantity": 5, "unit": "ml", "description": ""},
        {"name": "garlic", "quantity": 2, "unit": "units", "description": "cloves, minced"},
        {"name": "red bell pepper", "quantity": 1, "unit": "units", "description": "sliced"},
        {"name": "carrots", "quantity": 100, "unit": "grams", "description": "shredded"},
        {"name": "green onions", "quantity": 3, "unit": "units", "description": "sliced"},
        {"name": "peanuts", "quantity": 30, "unit": "grams", "description": "crushed, for topping"},
        {"name": "vegetable oil", "quantity": 30, "unit": "ml", "description": "for frying"}
      ],
      "instructions": [
        {"step_number": 1, "description": "Press tofu to remove excess moisture, then cut into cubes."},
        {"step_number": 2, "description": "Cook rice noodles according to package directions, drain and set aside."},
        {"step_number": 3, "description": "Heat vegetable oil in a large pan and fry tofu until golden on all sides. Remove and set aside."},
